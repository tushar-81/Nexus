# OpenAI — used by every agent (gpt-4o-mini) and for search embeddings
OPENAI_API_KEY=sk-...

# Trello — https://trello.com/power-ups/admin
TRELLO_API=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Gmail app password (not your account password) — https://myaccount.google.com/apppasswords
GOOGLE_MAIL=your_gmail_app_password

# Optional: path to wkhtmltopdf if it is not on PATH
# WKHTMLTOPDF_PATH=C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe
